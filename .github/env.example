# AI QUANT 4.0 - Example environment
# Paper trading only. Never place real exchange orders.

HOST=0.0.0.0
PORT=7860
DB_PATH=/data/ai_quant.db

# Market configuration
SYMBOLS=BTC-USDT,ETH-USDT,BNB-USDT,SOL-USDT,XRP-USDT
KLINE_LIMIT=300
SCAN_INTERVAL_SECONDS=180
STARTING_BALANCE=200
MIN_SCORE_TO_ENTER=75

# Hugging Face AI Council (optional)
HF_TOKEN=
HF_API_URL=https://router.huggingface.co/v1/chat/completions
HF_MODELS=
AI_TIMEOUT_SECONDS=20
AI_MIN_MODELS=2
AI_MIN_AGREEMENT=0.60

# Telegram notifications (optional)
TELEGRAM_TOKEN=
TELEGRAM_ADMIN_ID=

# Network and news
HTTP_TIMEOUT_SECONDS=15
NEWS_REFRESH_SECONDS=600

# CORS: comma-separated allowed origins.
# Leave empty if no external browser origin is required.
CORS_ORIGINS=
